@model NetSplit.Models.CreateGroupViewModel
@{
    ViewData["Title"] = "Create Group";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <div class="mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-left me-1"></i> Back to Groups
                    </a>
                    <h3 class="fw-bold mt-2">Create New Group</h3>
                    <p class="text-muted small">Set up a space for shared group expenses</p>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label font-weight-bold">Group Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Goa Trip, Flat 302, Weekend Party" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description (Optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief note about what this group is for..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Currency" class="form-label font-weight-bold">Default Currency</label>
                        <select asp-for="Currency" class="form-select">
                            <option value="INR">INR (₹)</option>
                            <option value="USD">USD ($)</option>
                            <option value="EUR">EUR (€)</option>
                            <option value="GBP">GBP (£)</option>
                        </select>
                        <span asp-validation-for="Currency" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Create Group
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
