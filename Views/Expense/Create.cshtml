@model NetSplit.Models.AddExpenseViewModel
@{
    ViewData["Title"] = "Add Expense - " + Model.GroupName;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4">
                <div class="mb-4">
                    <a asp-controller="Group" asp-action="Details" asp-route-id="@Model.GroupId" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-left me-1"></i> Back to @Model.GroupName Dashboard
                    </a>
                    <h3 class="fw-bold mt-2">Add New Expense</h3>
                    <p class="text-muted small">Log a shared expense for <strong>@Model.GroupName</strong></p>
                </div>

                <form asp-action="Create" method="post" id="expenseForm">
                    <input type="hidden" asp-for="GroupId" />
                    <input type="hidden" asp-for="GroupName" />
                    <input type="hidden" asp-for="Currency" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <!-- Expense Title -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label font-weight-bold">Expense Description / Title</label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Hotel Stay, Dinner, Taxi, Groceries" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <!-- Amount & Currency -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Amount" class="form-label font-weight-bold">Total Amount (@Model.Currency)</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text fw-bold">@Model.Currency</span>
                                <input asp-for="Amount" id="expenseAmount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PaidByUserId" class="form-label font-weight-bold">Paid By</label>
                            <select asp-for="PaidByUserId" class="form-select form-select-lg">
                                @foreach (var member in Model.AvailableMembers)
                                {
                                    <option value="@member.UserId">@member.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="PaidByUserId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Split Type Selector -->
                    <div class="mb-4">
                        <label class="form-label font-weight-bold d-block">Split Method</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="SplitType" id="splitEqual" value="Equal" @(Model.SplitType == NetSplit.Models.SplitType.Equal ? "checked" : "") onclick="toggleSplitType('Equal')" />
                            <label class="btn btn-outline-primary py-2 fw-bold" for="splitEqual">
                                <i class="bi bi-pie-chart me-1"></i> Equal Split
                            </label>

                            <input type="radio" class="btn-check" name="SplitType" id="splitCustom" value="Custom" @(Model.SplitType == NetSplit.Models.SplitType.Custom ? "checked" : "") onclick="toggleSplitType('Custom')" />
                            <label class="btn btn-outline-primary py-2 fw-bold" for="splitCustom">
                                <i class="bi bi-sliders me-1"></i> Custom Split
                            </label>
                        </div>
                    </div>

                    <!-- Split Participants -->
                    <div class="mb-4">
                        <label class="form-label font-weight-bold">Split Between Participants</label>
                        <div class="card border p-3 bg-light rounded-3">
                            <div id="participantsList" class="d-flex flex-column gap-2">
                                @foreach (var member in Model.AvailableMembers)
                                {
                                    bool isChecked = Model.SelectedParticipantIds.Contains(member.UserId);
                                    decimal customVal = Model.CustomShares.TryGetValue(member.UserId, out decimal cv) ? cv : 0m;

                                    <div class="d-flex align-items-center justify-content-between p-2 bg-white rounded border">
                                        <div class="form-check m-0">
                                            <input class="form-check-input participant-check" type="checkbox" name="SelectedParticipantIds" value="@member.UserId" id="p_@member.UserId" @(isChecked ? "checked" : "") onchange="calculateSplitPreview()" />
                                            <label class="form-check-label fw-bold ms-2" for="p_@member.UserId">
                                                @member.FullName
                                            </label>
                                        </div>

                                        <!-- Custom Share Input (visible in Custom mode) -->
                                        <div class="custom-share-container" style="display: @(Model.SplitType == NetSplit.Models.SplitType.Custom ? "block" : "none"); width: 140px;">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">@Model.Currency</span>
                                                <input type="number" step="0.01" class="form-control custom-share-input" name="CustomShares[@member.UserId]" value="@customVal" oninput="calculateSplitPreview()" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Preview Helper Box -->
                            <div class="mt-3 p-2 bg-white rounded border small text-muted d-flex justify-content-between align-items-center" id="splitPreviewBox">
                                <span>Calculated share preview:</span>
                                <strong id="splitPreviewText" class="text-primary fs-6">Select participants and amount</strong>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm fs-5">
                        <i class="bi bi-check-circle me-1"></i> Save Expense
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleSplitType(type) {
            const containers = document.querySelectorAll('.custom-share-container');
            containers.forEach(el => {
                el.style.display = (type === 'Custom') ? 'block' : 'none';
            });
            calculateSplitPreview();
        }

        function calculateSplitPreview() {
            const amountInput = document.getElementById('expenseAmount');
            const totalAmount = parseFloat(amountInput.value) || 0;
            const checkboxes = document.querySelectorAll('.participant-check:checked');
            const previewText = document.getElementById('splitPreviewText');
            const isCustom = document.getElementById('splitCustom').checked;

            if (checkboxes.length === 0) {
                previewText.textContent = "Please select at least 1 participant.";
                previewText.className = "text-danger fw-bold";
                return;
            }

            if (!isCustom) {
                const perPerson = totalAmount / checkboxes.length;
                previewText.textContent = `${checkboxes.length} participants • @Model.Currency ${perPerson.toFixed(2)} each`;
                previewText.className = "text-primary fw-bold";
            } else {
                let customSum = 0;
                checkboxes.forEach(cb => {
                    const row = cb.closest('.d-flex');
                    const input = row.querySelector('.custom-share-input');
                    if (input) {
                        customSum += parseFloat(input.value) || 0;
                    }
                });

                const diff = totalAmount - customSum;
                if (Math.abs(diff) < 0.01) {
                    previewText.textContent = `Sum matches total (@Model.Currency ${customSum.toFixed(2)}) ✓`;
                    previewText.className = "text-success fw-bold";
                } else {
                    previewText.textContent = `Custom sum (@Model.Currency ${customSum.toFixed(2)}) differs from total by @Model.Currency ${diff.toFixed(2)}`;
                    previewText.className = "text-danger fw-bold";
                }
            }
        }

        document.getElementById('expenseAmount').addEventListener('input', calculateSplitPreview);
        document.addEventListener('DOMContentLoaded', calculateSplitPreview);
    </script>
}
